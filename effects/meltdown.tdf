[MeltdownTwinkle]
{
	[twinkler1] {
    class=CSimpleParticleSystem;
    [properties]{
      sizeGrowth=1;
      sizeMod=1;
      pos=0, 0, 0;
      emitVector=0, 0, 0;
      gravity=0, 0, 0;
      colorMap=1 1 1 0.25  1 1 1 0.25  0 0 0 0;
      Texture=electricalarc;
      airdrag=0;
      particleLife=12;
	  particleLifeSpread=6;
      numParticles=1;
      particleSpeed=0;
      particleSize=25;
	  particleSizeSpread=25;
      emitRot=360;
	  emitRotSpread=360;
      directional=0;
      alwaysVisible=0;
    }
    air=1;
    water=1;
    ground=1;
    count=1;
  }
  
  [twinkler2] {
    class=CSimpleParticleSystem;
    [properties]{
      sizeGrowth=1;
      sizeMod=1;
      pos=0, 0, 0;
      emitVector=0, 0, 0;
      gravity=0, 0, 0;
      colorMap=1 1 1 0.25  1 1 1 0.25  0 0 0 0;
      Texture=expandingstrobe2;
      airdrag=0;
      particleLife=12;
	  particleLifeSpread=6;
      numParticles=1;
      particleSpeed=0;
      particleSize=25;
	  particleSizeSpread=25;
      emitRot=360;
	  emitRotSpread=360;
      directional=0;
      alwaysVisible=0;
    }
    air=1;
    water=1;
    ground=1;
    count=1;
  }
  
  [bigboom] 
	{
	    class=CExpGenSpawner;
		[properties]
		{
		pos=0, 0,  0;
		delay=100;				
		explosionGenerator=custom:Meltdown;
		}
	air=1;
	water=1;
	ground=1;
	count=1;
	}
}



[MeltdownFireball]
{
	[fire] {
    class=CSimpleParticleSystem;
    [properties]{
      sizeGrowth=6 r6;
      sizeMod=0.9;
      pos=0, 0, 0;
      emitVector=0, 1, 0;
      gravity=0, 0.5, 0;
      colorMap=1 1 1 0.25  0.025 0.025 0.025 0.25  0 0 0 0;
      Texture=flameball;
      airdrag=0.75;
      particleLife=256;
      particleLifeSpread=128;
      numParticles=64;
      particleSpeed=18;
      particleSpeedSpread=6;
      particleSize=100;
      particleSizeSpread=35;
      emitRot=0;
      emitRotSpread=180;
      directional=0;
      alwaysVisible=0;
    }
    air=1;
    water=1;
    ground=1;
    count=2;
  }
}


