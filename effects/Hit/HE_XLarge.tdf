    class=CSimpleParticleSystem;
		[properties]
		{
		  sizeGrowth=0;
		  sizeMod=1.0;
		  pos=0, 1, 0;
		  emitVector=0, 1, 0;
		  gravity=0, -0.3, 0;
		  colorMap=0.3 0.22 0.17 0.1  0.3 0.22 0.17 1;
		  Texture=debris2;
		  airdrag=0.8;
		  particleLife=64;
		  particleLifeSpread=24;
		  numParticles=6 r4;
		  particleSpeed=12;
		  particleSpeedSpread=12;
		  particleSize=12;
