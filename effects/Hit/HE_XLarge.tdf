[HE_XLarge] {
	usedefaultexplosions=0;

	[flashbang] {
    class=CSimpleParticleSystem;
    [properties]{
      sizeGrowth=1;
      sizeMod=1;
      pos=0, 0, 0;
      emitVector=0, 0, 0;
      gravity=0, 1, 0;
      colorMap=1 1 1 0.25 1 .8 .7 0.25 0 0 0 0;
      Texture=fireball;
      airdrag=0;
      particleLife=8;
      numParticles=1;
      particleSpeed=0;
      particleSize=120;
      emitRot=0;
      directional=0;
      alwaysVisible=1;
    }
    air=1;
    water=1;
    ground=1;
    count=1;
	}
	
	[fire] {
    class=CSimpleParticleSystem;
    [properties]{
      sizeGrowth=6 r6;
      sizeMod=0.7;
      pos=0, 0, 0;
      emitVector=0, 1, 0;
      gravity=0, 0.5, 0;
      colorMap=1 1 1 0.25  0.025 0.025 0.025 0.25  0 0 0 0;
      Texture=flameball;
      airdrag=0.75;
      particleLife=64;
      particleLifeSpread=24;
      numParticles=24;
      particleSpeed=6;
      particleSpeedSpread=3;
      particleSize=45;
      particleSizeSpread=20;
      emitRot=0;
      emitRotSpread=90;
      directional=0;
      alwaysVisible=0;
    }
    air=1;
    water=1;
    ground=1;
    count=2;
  }
  
	[airheat] {
		class=CHeatCloudProjectile;
		[properties] {
			heat = 8;
			maxheat = 16;
			heatFalloff = 1;
			size=1;
			sizeGrowth = 4;
			texture=heatcloud;
			pos=-4 r8, -4 r8, -4 r8;
		}
		air=1;
		count=4;
		ground=1;
		water=1;
	}
	
	[water]{
		class = CBitmapMuzzleFlame;  
		[properties]{
			dir = -0.1 r0.2, 1, -0.1 r0.2;
			colorMap=0.45 0.45 0.5 0.5  0.045 0.045 0.05 0.05; 
			size=8 r4;
			length=16 r16;
			sizeGrowth=1;
			ttl=24;
			frontOffset=0;
			sideTexture=splashside;
			frontTexture=splashbase;
		}
		water=1;
		count=8;
	}
  
  [dust1] {
    class=CSimpleParticleSystem;
    [properties]{
      sizeGrowth=6 r6;
      sizeMod=0.5;
      pos=0, 0, 0;
      emitVector=0, 1, 0;
      gravity=0, -0.01, 0;
      colorMap=0.5 0.4 0.3 1  0.05 0.04 0.03 0.1;
      Texture=dust2;
      airdrag=0.75;
      particleLife=48;
      particleLifeSpread=24;
      numParticles=24;
      particleSpeed=24;
      particleSpeedSpread=12;
      particleSize=20;
      particleSizeSpread=10;
      emitRot=0;
      emitRotSpread=90;
      directional=0;
      alwaysVisible=0;
    }
    ground=1;
    count=1;
  }
  
  [dust2] {
    class=CSimpleParticleSystem;
    [properties]{
      sizeGrowth=6 r6;
      sizeMod=0.7;
      pos=0, 0, 0;
      emitVector=0, 1, 0;
      gravity=0, -0.01, 0;
      colorMap=0.5 0.4 0.3 1  0.05 0.04 0.03 0.1;
      Texture=dust2;
      airdrag=0.75;
      particleLife=48;
      particleLifeSpread=24;
      numParticles=24;
      particleSpeed=12;
      particleSpeedSpread=6;
      particleSize=40;
      particleSizeSpread=20;
      emitRot=0;
      emitRotSpread=90;
      directional=0;
      alwaysVisible=0;
    }
    ground=1;
    count=1;
  }
	
	[dirt_sprinkle] {
    class=CSimpleParticleSystem;
		[properties]
		{
		  sizeGrowth=0;
		  sizeMod=1.0;
		  pos=0, 1, 0;
		  emitVector=0, 1, 0;
		  gravity=0, -0.3, 0;
		  colorMap=0.6 0.45 0.35 1  0.05 0.04 0.03 0.1;
		  Texture=randdots;
		  airdrag=0.8;
		  particleLife=64;
		  particleLifeSpread=24;
		  numParticles=4;
		  particleSpeed=6;
		  particleSpeedSpread=18;
		  particleSize=36;
		  particleSizeSpread=12;
		  emitRot=0;
		  emitRotSpread=90;
		  directional=1;
		}
    unit=1;
    ground=1;
    count=1;
    }
	
	[dirt_debris1] {
    class=CSimpleParticleSystem;
