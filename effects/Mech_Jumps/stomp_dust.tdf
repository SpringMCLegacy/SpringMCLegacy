		{
			class=CSimpleParticleSystem;
			[properties]
			{
			sizeGrowth=0.80;
			sizeMod=1.0;
			pos=0, 1, 0; 
			gravity=0, 0.05, 0;
			

			Texture=mist;
			airdrag=0.87;
			colorMap=0.25 0.20 0.10 0.5	0 0 0 0.0;

			particleLifeSpread=15; 
			particleSpeedSpread=1;  
			particleSizeSpread=2;   
			
			particleLife=15;
			numParticles=4; 
			particleSpeed=1; 
			particleSize=8;
			
			
			emitVector=0, 1, 0; 
			emitRot=360;
			emitRotSpread=90; 
			directional=0; 
			alwaysVisible=0;

			}
		air=0;
		water=0;
		ground=1;
		count=1;
		}

		
		[el_splashe]
		{
			class=CSimpleParticleSystem;
			[properties]
			{
			sizeGrowth=0.80;
			sizeMod=1.0;
