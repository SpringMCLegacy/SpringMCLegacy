[ARTILLERY_MUZZLEFLASH]
{
   [BitmapMuzzleFlame]
   {
	class = CBitmapMuzzleFlame;
      
	[properties]
      	{
         	dir = dir;
         	colorMap=1 1 0.5 0.01	1 0.7 0 0.01	0 0 0 0.01; 
          	size=1;
          	length=1.8;
          	sizeGrowth=70;
          	ttl=5;
          	frontOffset=0.3;
          	sideTexture=plasma2;
          	frontTexture=plasma0029;
			alwaysvisible=1;
      	}
   water=1;
   air=1;
   underwater=1;
   ground=1;
   count=1;
   }
   
   [flashbang] {
    class=CSimpleParticleSystem;
    [properties]{
      sizeGrowth=1;
      sizeMod=1;
      pos=0, 0, 0;
      emitVector=0, 0, 0;
      gravity=0, 0, 0;
      colorMap=1 1 1 0.25 1 .8 .7 0.25 0 0 0 0;
      Texture=fireball;
      airdrag=0;
      particleLife=8;
      numParticles=1;
      particleSpeed=0;
      particleSize=60;
      emitRot=0;
      directional=1;
      alwaysVisible=1;
    }
    air=1;
    water=1;
    ground=1;
    count=1;
	}
	
	[groundflash] {
		class=CSimpleGroundFlash;
		[properties]{
		size=220;
		sizeGrowth=100;
		ttl=8;
		colorMap=1 1 1 0.25 1 .8 .7 0.25 0 0 0 0;
		Texture=smoke_particle;
	}
	air=1;
    water=1;
    ground=1;
	}
}

[ARTILLERY_MUZZLEFLASH_SMALL]
{
   [BitmapMuzzleFlame]
   {
	class = CBitmapMuzzleFlame;
      
	[properties]
      	{
         	dir = dir;
         	colorMap=1 1 0.5 0.01	1 0.7 0 0.01	0 0 0 0.01; 
          	size=0.75;
          	length=1.3;
          	sizeGrowth=70;
          	ttl=5;
          	frontOffset=0.3;
          	sideTexture=plasma2;
          	frontTexture=plasma0029;
			alwaysvisible=1;
      	}
   water=1;
   air=1;
   underwater=1;
   ground=1;
   count=1;
   }
   
   [flashbang] {
    class=CSimpleParticleSystem;
    [properties]{
      sizeGrowth=1;
      sizeMod=1;
      pos=0, 0, 0;
      emitVector=0, 0, 0;
      gravity=0, 0, 0;
      colorMap=1 1 1 0.25 1 .8 .7 0.25 0 0 0 0;
      Texture=fireball;
      airdrag=0;
      particleLife=8;
      numParticles=1;
      particleSpeed=0;
      particleSize=30;
      emitRot=0;
      directional=1;
      alwaysVisible=0;
    }
    air=1;
    water=1;
    ground=1;
    count=1;
	}
	
	[groundflash] {
		flashsize=64;
		flashalpha=1;
		circlegrowth=10;
		circlealpha=0;
		ttl=8;
		color=1,0.75,0.5;
	}
}