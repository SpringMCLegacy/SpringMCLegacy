			sizeGrowth=0;
			sizeMod=1.0;
			pos=0, 0, 0;
			emitVector=0, 1, 0;
			gravity=0, 0, 0;
			colorMap=0.8 0.8 0.9 1.0    0.6 0.6 0.7 0.6    0.1 0.2 0.4 0.2   0.0 0.0 0.0 0.000;
			Texture=smoke;
			airdrag=0.9;
			particleLife=2;
			particleLifeSpread=1;
			numParticles=1;
